# Opcional. Por defecto se busca el modelo en /models/gemma.task (public/models/gemma.task).
# Descarga un modelo Gemma compatible (.task o .litertlm) desde Kaggle Models
# o Google AI Edge (requiere aceptar la licencia) y colócalo ahí, o apunta
# esta variable a otra URL donde lo hospedes.
VITE_GEMMA_MODEL_URL=/models/gemma.task

# Opcional. Runtime WASM de MediaPipe. Por defecto usa jsDelivr (requiere
# internet). Para un demo 100% offline, copia la carpeta wasm de
# node_modules/@mediapipe/tasks-genai/wasm a public/wasm y apunta aquí.
VITE_MEDIAPIPE_WASM_BASE=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-genai@latest/wasm
