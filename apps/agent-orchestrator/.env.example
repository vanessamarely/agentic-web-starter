GEMINI_API_KEY=your-google-genai-api-key
PORT=8787

# --- Solo necesarias para el modo "Agent Platform" (Gemini Enterprise Agent
# Platform / Vertex AI) — déjalas comentadas si solo usas Google AI Studio. ---
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
#
# Autenticación para Agent Platform — elige UNA:
#   a) No pongas nada más: se usa Application Default Credentials
#      (gcloud auth application-default login, o la identidad del propio
#      servicio en Cloud Run). No necesita ninguna key.
#   b) O define esto para autenticar con una API key en vez de ADC (no
#      necesitas gcloud instalado ni hacer login en tu máquina):
# AGENT_PLATFORM_API_KEY=your-cloud-console-api-key
