{
  "hosting": [
    {
      "target": "webclient",
      "public": "apps/web-client/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "models/**", "wasm/**"],
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "agent-orchestrator",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "codelab",
      "public": "apps/codelab/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
